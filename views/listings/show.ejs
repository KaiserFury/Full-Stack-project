<% layout('layouts/boilerplate') -%>

    <body>
        <p class="h1 show-title mt-3 mb-4">
            <%= listing.title %>
        </p>

        <div class="row align-items-start">
            <div class="col-md-5">
                <div class="img-box">
                    <img src="<%= listing.image.url %>" alt="listing_image"
                        style=" width: 100%; height: 25rem; object-fit: contain;" class="card-img-top">
                </div>
                <p> Owned By <i>
                        <%= listing.owner.username%>
                    </i> </p>
            </div>
            <div class="col-md-7">
                <ul class="list-unstyled">

                    <li>
                        <b>Description: </b>
                        <%= listing.description %>
                    </li>
                    <li>
                        <b>Price: </b>&#8377;<%= listing.price.toLocaleString("en-IN") %>
                    </li>
                    <li>
                        <b>Location: </b>
                        <%= listing.location %>
                    </li>
                    <li>
                        <b>Country: </b>
                        <%= listing.country %>
                    </li>
                    <li>
                        <b>Rating: </b>

                    </li>
                </ul>

                <%if (currentLoginStatus && currentLoginStatus._id.equals(listing.owner._id)) {%>
                    <a href="<%=listing._id%>/edit" class="btn btn-danger">Edit details</a>
                    <a href="<%=listing._id%>/delete" class="btn btn-danger m-2">Delete listing</a>
                    <% } %>
                        <%if (currentLoginStatus) {%>
                            <div>
                                <hr class="border border-danger border-2 opacity-50">

                                <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate
                                    class="needs-validation">
                                    <p class="h5 fw-bold">Leave Review</p>

                                    <div>
                                        <label for="rating" class="form-label ">Rating</label>
                                        <fieldset class="starability-slot">
                                            <input type="radio" id="rating" class="input-no-rate"
                                                name="reviews[rating]" value="1" checked aria-label="No rating." />
                                            <input type="radio" id="first-rate1" name="reviews[rating]" value="1" />
                                            <label for="first-rate1" title="Terrible">1 star</label>
                                            <input type="radio" id="first-rate2" name="reviews[rating]" value="2" />
                                            <label for="first-rate2" title="Not good">2 stars</label>
                                            <input type="radio" id="first-rate3" name="reviews[rating]" value="3" />
                                            <label for="first-rate3" title="Average">3 stars</label>
                                            <input type="radio" id="first-rate4" name="reviews[rating]" value="4" />
                                            <label for="first-rate4" title="Very good">4 stars</label>
                                            <input type="radio" id="first-rate5" name="reviews[rating]" value="5" />
                                            <label for="first-rate5" title="Amazing">5 stars</label>
                                        </fieldset>
                                    </div>
                                    <label for="comment" class="form-label">Comment</label>
                                    <div class="input-group mb-3">
                                        <textarea class="form-control border border-danger " id="comment" rows="2"
                                            name="reviews[comment]" required></textarea>
                                        <span class="input-group-text">
                                            <button type="submit" class="btn btn--secondary">Submit Review</button>
                                        </span>
                                    </div>
                                </form>

                            </div>
                            <%}%>

            </div>

            <hr class="border border-secondary border-2 opacity-50">
            <div class="reviews">
                <p class="h4 fw-bold">Reviews</p>
                <div class="row mb-4">
                    <%for(let opition of listing.reviews) {%>
                        <div class="card ms-1 mb-2 col-3" style="width: 20rem;">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="card-title">@<%=opition.author.username%>
                                    </h5>
                                    <p class="card-subtitle mb-2 text-body-secondary starability-result"
                                        data-rating="<%= opition.rating %>">
                                    </p>

                                    <p class="card-text mb-1">
                                        <%= opition.comment%>
                                    </p>
                                </div>
                                <%if(currentLoginStatus && currentLoginStatus._id.equals(opition.author._id)) {%>
                                    <form class="mt-3"
                                        action="/listings/<%= listing._id%>/reviews/<%= opition._id%>?_method=DELETE"
                                        method="POST">
                                        <button class="btn btn-danger mb-1">Delete Reviews</button>
                                    </form>
                                    <%}%>
                            </div>
                        </div>
                        <%}%>
                </div>
            </div>
        </div>
    </body>
